---
import Layout from '../layouts/Layout.astro';
---

<Layout title="My Games | Voron Creations" active="games">
	<main class="page">
		<section class="games-hero">
			<p class="over">Over 9.5M+ visits</p>
			<h1>Voron Creations</h1>
			<p>Games made by me</p>
		</section>

		<section class="games-section">
			<div class="games-section-inner">
				<div class="games-grid">
					<article class="game-card">
						<img
							src="/assets/dodge-lasers.png"
							alt="Dodge the Lasers!"
							width="512"
							height="512"
							loading="lazy"
						/>
						<div class="game-card-body">
							<h3>Dodge the Lasers!</h3>
							<div class="game-meta">
								<span><strong>9.4M+</strong> visits</span>
								<span><strong>13.3K</strong> favorites</span>
							</div>
							<p class="game-desc">
								Survive the lasers and become the winner! Climb the leaderboard and unlock new
								skills. Currently in beta.
							</p>
							<a
								class="btn btn-green"
								href="https://www.roblox.com/games/128740661033853/Dodge-the-Lasers"
								target="_blank"
								rel="noopener noreferrer">Play Now</a
							>
						</div>
					</article>

					<article class="game-card">
						<img
							src="/assets/idle-melon.png"
							alt="Idle Melon Incremental"
							width="512"
							height="512"
							loading="lazy"
						/>
						<div class="game-card-body">
							<h3>Idle Melon Incremental</h3>
							<div class="game-meta">
								<span><strong>77K+</strong> visits</span>
								<span><strong>644</strong> favorites</span>
							</div>
							<p class="game-desc">
								Farm watermelons, unlock new melons, level up areas, prestige for multipliers, and
								compete on leaderboards.
							</p>
							<a
								class="btn btn-green"
								href="https://www.roblox.com/games/90607799581188/Idle-Melon-Incremental"
								target="_blank"
								rel="noopener noreferrer">Play Now</a
							>
						</div>
					</article>
				</div>
			</div>
		</section>

		<div class="community-wrap">
			<div class="community">
				<div class="community-copy">
					<h2>Play my games today!</h2>
					<p>Jump into a Voron Creations experience on Roblox.</p>
					<div class="hero-actions" style="margin-top: 1.5rem">
						<a
							class="btn btn-green"
							href="https://www.roblox.com/games/128740661033853/Dodge-the-Lasers"
							target="_blank"
							rel="noopener noreferrer">Dodge the Lasers!</a
						>
						<a
							class="btn btn-outline"
							href="https://www.roblox.com/games/90607799581188/Idle-Melon-Incremental"
							target="_blank"
							rel="noopener noreferrer">Idle Melon</a
						>
					</div>
				</div>
				<div class="community-mascot">
					<img src="/assets/idle-melon.png" alt="Idle Melon" width="400" height="400" loading="lazy" />
				</div>
			</div>
		</div>
	</main>
</Layout>
