---
<div
	id="hero-splash"
	class="z-[100] fixed inset-0 flex justify-center items-center bg-black/95 backdrop-blur-sm transition-all duration-300 ease-out"
	aria-hidden="true"
>
	<img
		src="/hero-logo.png"
		alt=""
		width="180"
		height="180"
		draggable="false"
		class="w-36 h-36 sm:w-44 sm:h-44 object-contain motion-safe:animate-pulse select-none"
		loading="eager"
	/>
</div>
<script is:inline>
	(function () {
		var el = document.getElementById('hero-splash');
		if (!el) return;
		var hide = function () {
			el.classList.add('opacity-0', 'pointer-events-none');
			setTimeout(function () {
				el.remove();
			}, 320);
		};
		var schedule = function () {
			setTimeout(hide, 420);
		};
		if (document.readyState !== 'loading') {
			schedule();
		} else {
			document.addEventListener('DOMContentLoaded', schedule);
		}
	})();
</script>
