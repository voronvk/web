---
import { aboutMe } from '../data/site';
import { getRobloxAvatarHeadshot } from '../lib/roblox-user';
import SocialLinks from './SocialLinks.astro';

let avatarUrl: string | null = null;
try {
	avatarUrl = await getRobloxAvatarHeadshot(aboutMe.robloxUserId);
} catch {
	avatarUrl = null;
}
---

<section
	id="about"
	class="relative z-10 border-white/5 border-t bg-black/30 px-4 py-20 sm:px-6 lg:px-8"
>
	<div class="mx-auto max-w-7xl">
		<div class="grid gap-12 lg:grid-cols-[minmax(0,280px)_1fr] lg:items-start lg:gap-16">
			<div class="mx-auto w-full max-w-xs lg:mx-0">
				{
					avatarUrl ? (
						<a
							href={aboutMe.robloxProfileUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="group block focus:outline-none focus-visible:ring-2 focus-visible:ring-[#22c55e] focus-visible:ring-offset-2 focus-visible:ring-offset-black rounded-2xl"
						>
							<img
								src={avatarUrl}
								alt={aboutMe.photoAlt}
								width="420"
								height="420"
								class="aspect-square w-full rounded-2xl border border-white/10 object-cover transition-[border-color] duration-300 group-hover:border-[#22c55e]/40"
								loading="lazy"
								decoding="async"
							/>
						</a>
					) : (
						<div class="flex aspect-square w-full flex-col items-center justify-center rounded-2xl border border-dashed border-white/20 bg-white/[0.03] px-6 text-center">
							<p class="text-sm font-medium text-white/50">Roblox avatar</p>
							<p class="mt-2 text-xs text-white/30 leading-relaxed">Could not load profile image.</p>
						</div>
					)
				}
			</div>
			<div>
				<h2 class="text-sm font-semibold uppercase tracking-widest text-[#22c55e]">
					{aboutMe.eyebrow}
				</h2>
				<p class="mt-3 text-3xl font-bold tracking-tight text-white leading-tight sm:text-4xl">
					{aboutMe.title}
				</p>
				<div class="mt-6 space-y-4 text-base leading-relaxed text-white/50 sm:text-lg">
					{aboutMe.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
				</div>
				<div class="mt-8">
					<p class="mb-3 text-xs font-semibold uppercase tracking-widest text-white/40">
						Socials
					</p>
					<SocialLinks />
				</div>
			</div>
		</div>
		<div class="mt-16 grid gap-6 sm:grid-cols-3">
			{
				aboutMe.highlights.map((item) => (
					<div class="rounded-xl border border-white/10 bg-white/[0.03] p-6 transition-[border-color,background-color] duration-500 hover:border-[#22c55e]/25 hover:bg-white/[0.06]">
						<h3 class="font-semibold text-white">{item.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-white/45">{item.description}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
