---
---
<section
	id="about"
	class="relative z-10 border-white/5 border-t bg-black/30 px-4 py-20 sm:px-6 lg:px-8"
>
	<div class="mx-auto max-w-7xl">
		<div class="grid gap-12 md:grid-cols-2 md:items-center">
			<div>
				<h2 class="text-sm font-semibold uppercase tracking-widest text-[#22c55e]">About</h2>
				<p class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-white leading-tight">
					We ship games players return to
				</p>
			</div>
			<p class="text-white/50 text-base sm:text-lg leading-relaxed">
				Voron Creations is Voron&apos;s Roblox label &mdash; incrementals and sims built for
				retention and long sessions, with live stats on this site so you can see what&apos;s
				happening before you jump in.
			</p>
		</div>
		<div
			class="mt-16 grid gap-6 sm:grid-cols-3"
		>
			{
				[
					{ t: 'Live operations', d: 'Seasons, events, and updates on a tight cadence.' },
					{ t: 'Monetization', d: 'Fair flows that support long-term community health.' },
					{ t: 'Cross-platform', d: 'Built for Roblox scale across devices.' },
				].map((item) => (
					<div class="rounded-xl border border-white/10 bg-white/[0.03] p-6 transition-all duration-500 hover:border-[#22c55e]/25 hover:bg-white/[0.06]">
						<h3 class="font-semibold text-white">{item.t}</h3>
						<p class="mt-2 text-sm text-white/45 leading-relaxed">{item.d}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
