---
import { formatCompact, projectPlaceholderImage } from '../data/site';
import { getCuratedRobloxGamesPayload } from '../lib/roblox-group-games';

let initialGames: Awaited<ReturnType<typeof getCuratedRobloxGamesPayload>>['games'] = [];
try {
	const payload = await getCuratedRobloxGamesPayload();
	initialGames = payload.games;
} catch {
	initialGames = [];
}

const hasSsrGames = initialGames.length > 0;
---

<section
	id="games"
	class="relative z-10 px-4 py-20 sm:px-6 lg:px-8 [content-visibility:auto] [contain-intrinsic-size:auto_720px]"
>
	<div class="mx-auto max-w-7xl">
		<div class="mb-12 md:mb-16 max-w-xl">
			<h2 class="text-sm font-semibold uppercase tracking-widest text-[#22c55e]">
				Featured games
			</h2>
			<p class="mt-2 text-3xl sm:text-4xl font-bold text-white tracking-tight">Our experiences</p>
			<p class="mt-3 text-white/45 text-base">
				Live stats for the Roblox games linked on this site. No group list, just the
				experiences Voron publishes here.
			</p>
		</div>
		<p
			id="group-games-status"
			class:list={[
				'text-white/50 text-center py-16 text-sm',
				hasSsrGames && 'hidden',
			]}
		>
			Loading games…
		</p>
		<div
			id="group-games-grid"
			class:list={['grid gap-8 md:grid-cols-2 lg:grid-cols-3', !hasSsrGames && 'hidden']}
		>
			{
				initialGames.map((g) => (
					<article
						data-universe-id={g.universeId}
						class="group relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.02] [contain:paint] transition-[border-color] duration-500 hover:border-[#22c55e]/35"
					>
						<a
							href={g.gameUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="block focus:outline-none focus-visible:ring-2 focus-visible:ring-[#22c55e] focus-visible:ring-offset-2 focus-visible:ring-offset-black"
						>
							<div class="relative aspect-[16/9] overflow-hidden bg-zinc-900">
								<img
									src={g.thumbnailUrl ?? projectPlaceholderImage}
									alt=""
									width="768"
									height="432"
									class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
									loading="lazy"
									decoding="async"
								/>
								<div class="absolute bottom-0 left-0 right-0 flex flex-wrap items-end justify-between gap-2 bg-black/45 p-4 sm:p-5">
									<h3 class="pr-2 text-lg font-bold leading-tight text-white sm:text-xl">{g.name}</h3>
									<div class="flex gap-3 text-xs font-medium tabular-nums text-white/80">
										<span
											data-game-playing
											data-stat-value={g.playing}
											class="rounded-md border border-white/15 bg-black/65 px-2 py-1"
										>
											{g.playing.toLocaleString('en-US')} playing
										</span>
										<span
											data-game-visits
											data-stat-value={g.visits}
											class="rounded-md border border-white/15 bg-black/65 px-2 py-1"
										>
											{formatCompact(g.visits)} visits
										</span>
									</div>
								</div>
							</div>
							<div class="border-t border-white/5 px-5 py-4">
								<span class="inline-block text-sm font-medium text-[#22c55e] transition-transform duration-300 group-hover:translate-x-0.5">
									Play on Roblox →
								</span>
							</div>
						</a>
					</article>
				))
			}
		</div>
	</div>
</section>
<script is:inline define:vars={{ fallbackImg: projectPlaceholderImage }}>
	(function () {
		function formatVisits(n) {
			if (n >= 1000000000) {
				var v = n / 1000000000;
				return (v >= 10 ? v.toFixed(0) : v.toFixed(1).replace(/\.0$/, '')) + 'B';
			}
			if (n >= 1000000) {
				var v2 = n / 1000000;
				return (v2 >= 100 ? v2.toFixed(0) : v2.toFixed(1).replace(/\.0$/, '')) + 'M';
			}
			if (n >= 1000) {
				var v3 = n / 1000;
				return (v3 >= 100 ? v3.toFixed(0) : v3.toFixed(1).replace(/\.0$/, '')) + 'K';
			}
			return n.toLocaleString('en-US');
		}
		function applyLiveStats(rows) {
			var map = {};
			for (var i = 0; i < rows.length; i++) {
				var row = rows[i];
				var key = String(row.id != null ? row.id : row.universeId);
				map[key] = row;
			}
			var cards = document.querySelectorAll('#group-games-grid [data-universe-id]');
			for (var j = 0; j < cards.length; j++) {
				var card = cards[j];
				var uid = card.getAttribute('data-universe-id');
				var stat = map[uid];
				if (!stat) continue;
				var playing = typeof stat.playing === 'number' ? stat.playing : null;
				var visits = typeof stat.visits === 'number' ? stat.visits : null;
				var pEl = card.querySelector('[data-game-playing]');
				var vEl = card.querySelector('[data-game-visits]');
				if (pEl != null && playing != null) {
					animateStatChange(pEl, playing, function (value) {
						return value.toLocaleString('en-US') + ' playing';
					});
				}
				if (vEl != null && visits != null) {
					animateStatChange(vEl, visits, function (value) {
						return formatVisits(value) + ' visits';
					});
				}
			}
		}
		function animateStatChange(el, nextValue, formatFn) {
			var prevValue = Number(el.dataset.statValue);
			if (!Number.isFinite(prevValue)) {
				el.dataset.statValue = String(nextValue);
				el.textContent = formatFn(nextValue);
				return;
			}
			if (nextValue === prevValue) return;
			el.classList.remove('stat-change-up', 'stat-change-down');
			void el.offsetWidth;
			el.classList.add(nextValue > prevValue ? 'stat-change-up' : 'stat-change-down');
			el.dataset.statValue = String(nextValue);
			el.textContent = formatFn(nextValue);
		}
		function sortByPlaying(list) {
			return list.slice().sort(function (a, b) {
				var ap = typeof a.playing === 'number' ? a.playing : 0;
				var bp = typeof b.playing === 'number' ? b.playing : 0;
				return bp - ap;
			});
		}
		function currentGridOrder(grid) {
			return Array.from(grid.querySelectorAll('[data-universe-id]')).map(function (el) {
				return el.getAttribute('data-universe-id');
			});
		}
		function orderMatches(grid, sorted) {
			var current = currentGridOrder(grid);
			var next = sorted.map(function (g) {
				return String(g.universeId);
			});
			if (current.length !== next.length) return false;
			for (var i = 0; i < current.length; i++) {
				if (current[i] !== next[i]) return false;
			}
			return true;
		}
		function esc(s) {
			return String(s)
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/"/g, '&quot;');
		}
		function cardHtml(g) {
			var thumb = g.thumbnailUrl || fallbackImg;
			var playing = typeof g.playing === 'number' ? g.playing.toLocaleString('en-US') : 'N/A';
			var visits = typeof g.visits === 'number' ? formatVisits(g.visits) : 'N/A';
			var uid = esc(g.universeId);
			var name = esc(g.name);
			var href = esc(g.gameUrl);
			var imgSrc = esc(thumb);
			return (
				'<article data-universe-id="' +
				uid +
				'" class="group relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.02] [contain:paint] transition-[border-color] duration-500 hover:border-[#22c55e]/35">' +
				'<a href="' +
				href +
				'" target="_blank" rel="noopener noreferrer" class="block focus:outline-none focus-visible:ring-2 focus-visible:ring-[#22c55e] focus-visible:ring-offset-2 focus-visible:ring-offset-black">' +
				'<div class="relative aspect-[16/9] overflow-hidden bg-zinc-900">' +
				'<img src="' +
				imgSrc +
				'" alt="" width="768" height="432" class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" loading="lazy" decoding="async" />' +
				'<div class="absolute bottom-0 left-0 right-0 bg-black/45 p-4 sm:p-5 flex flex-wrap items-end justify-between gap-2">' +
				'<h3 class="text-lg sm:text-xl font-bold text-white leading-tight pr-2">' +
				name +
				'</h3>' +
				'<div class="flex gap-3 text-xs font-medium tabular-nums text-white/80">' +
				'<span data-game-playing data-stat-value="' +
				(typeof g.playing === 'number' ? g.playing : 0) +
				'" class="rounded-md border border-white/15 bg-black/65 px-2 py-1">' +
				playing +
				' playing</span>' +
				'<span data-game-visits data-stat-value="' +
				(typeof g.visits === 'number' ? g.visits : 0) +
				'" class="rounded-md border border-white/15 bg-black/65 px-2 py-1">' +
				visits +
				' visits</span>' +
				'</div></div></div>' +
				'<div class="px-5 py-4 border-t border-white/5">' +
				'<span class="text-[#22c55e] text-sm font-medium group-hover:translate-x-0.5 inline-block transition-transform duration-300">Play on Roblox →</span>' +
				'</div></a></article>'
			);
		}
		async function loadOnce(isRefresh) {
			var status = document.getElementById('group-games-status');
			var grid = document.getElementById('group-games-grid');
			if (!grid) return;
			var hasCards = !!grid.querySelector('article[data-universe-id]');
			try {
				var res = await fetch('/api/roblox-group-games.json', { credentials: 'same-origin' });
				if (!res.ok) {
					if (!isRefresh && hasCards) return;
					throw new Error('bad status');
				}
				var payload = await res.json();
				var list = payload.games;
				if (!Array.isArray(list)) list = [];
				list = sortByPlaying(list);
				if (!list.length && !isRefresh && hasCards) return;
				if (!isRefresh) {
					if (status) status.classList.add('hidden');
					grid.classList.remove('hidden');
					grid.innerHTML = list.map(cardHtml).join('');
					if (!list.length && status) {
						status.textContent = 'No linked games to show yet.';
						status.classList.remove('hidden');
						grid.classList.add('hidden');
					}
				} else if (!orderMatches(grid, list)) {
					grid.innerHTML = list.map(cardHtml).join('');
				} else {
					applyLiveStats(
						list.map(function (g) {
							return { id: g.universeId, playing: g.playing, visits: g.visits };
						}),
					);
				}
			} catch (e) {
				if (status && !isRefresh && !hasCards) {
					status.textContent = 'Could not load game data. Try again later.';
					status.classList.remove('hidden');
				}
			}
		}
		function start() {
			if (!document.getElementById('group-games-grid')) return;
			if (window.__heroGamesPollId) {
				clearInterval(window.__heroGamesPollId);
				window.__heroGamesPollId = null;
			}
			loadOnce(false);
			window.__heroGamesPollId = setInterval(function () {
				loadOnce(true);
			}, 60000);
		}
		document.addEventListener('astro:before-preparation', function () {
			if (window.__heroGamesPollId) {
				clearInterval(window.__heroGamesPollId);
				window.__heroGamesPollId = null;
			}
		});
		document.addEventListener('astro:page-load', start);
		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', start);
		} else {
			start();
		}
	})();
</script>
