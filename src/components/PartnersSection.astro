---
import { partners } from '../data/site';
---
<section
	id="partners"
	class="relative z-10 border-white/5 border-y bg-black/40 px-4 py-16 sm:px-6 lg:px-8"
>
	<div class="mx-auto max-w-7xl text-center">
		<h2 class="text-sm font-semibold uppercase tracking-widest text-white/50">Trusted for</h2>
		<p class="mt-2 text-2xl sm:text-3xl font-bold text-white">Partners &amp; live brands</p>
		<div
			class="mt-10 flex flex-wrap justify-center gap-3 sm:gap-4"
		>
			{
				partners.map((p) => (
					<div
						class="rounded-lg border border-white/10 bg-white/[0.04] px-6 py-3 text-sm font-medium text-white/70 transition-all duration-500 hover:border-[#ff007f]/30 hover:text-white hover:scale-105"
					>
						{p}
					</div>
				))
			}
		</div>
	</div>
</section>
