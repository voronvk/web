---
const year = new Date().getFullYear();
const quick = [
	{ href: '/', label: 'Home' },
	{ href: '/#games', label: 'Games' },
	{ href: '/contact', label: 'Contact' },
];
---
<footer class="relative z-10 border-white/5 border-t bg-black">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-12 md:pt-16 pb-8">
		<div class="grid gap-12 md:grid-cols-3">
			<div>
				<a href="/" class="mb-4 inline-flex items-center gap-4 group">
					<img
						src="/imagenes/Inicial.png"
						alt="Voron Creations"
						width="48"
						height="48"
						draggable="false"
						class="h-9 w-9 object-contain opacity-90 group-hover:opacity-100 transition-opacity"
					/>
					<span class="flex flex-col font-bold text-white text-lg leading-none">
						<span>Voron</span>
						<span>Creations</span>
					</span>
				</a>
				<p class="max-w-xs text-sm text-white/40 leading-relaxed">
					Roblox incrementals and more from Voron &mdash; live stats and links to every published
					experience.
				</p>
			</div>
			<div>
				<h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-white">Quick links</h3>
				<ul class="space-y-3">
					{
						quick.map((q) => (
							<li>
								<a
									href={q.href}
									class="text-sm text-white/40 transition-colors duration-200 hover:text-white"
								>
									{q.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
			<div>
				<h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-white">
					Connect with us
				</h3>
				<div class="flex items-center gap-4">
					<a
						href="https://x.com"
						target="_blank"
						rel="noopener noreferrer"
						class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-white/70 transition-all duration-300 hover:bg-white/10 hover:text-white"
						aria-label="X (Twitter)"
					>
						<svg
							class="h-[18px] w-[18px] opacity-80"
							viewBox="0 0 24 24"
							fill="currentColor"
							aria-hidden="true"
						>
							<path
								d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
							/>
						</svg>
					</a>
				</div>
			</div>
		</div>
		<div
			class="mt-12 flex flex-col gap-4 border-white/5 border-t pt-8 sm:flex-row sm:items-center sm:justify-between"
		>
			<p class="text-sm text-white/30">
				© {year} Voron Creations. All rights reserved.
			</p>
		</div>
	</div>
</footer>
