---
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
const quick = [
	{ href: '/', label: 'Home' },
	{ href: '/#games', label: 'Games' },
	{ href: '/#now', label: 'Now' },
	{ href: '/#about', label: 'About' },
	{ href: '/contact', label: 'Contact' },
];
---
<footer class="relative z-10 border-white/5 border-t bg-black">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-12 md:pt-16 pb-8">
		<div class="grid gap-12 md:grid-cols-3">
			<div>
				<a href="/" class="mb-4 inline-flex items-center gap-4 group">
					<img
						src="/imagenes/Inicial.png"
						alt="Voron Creations"
						width="48"
						height="48"
						draggable="false"
						class="h-9 w-9 object-contain opacity-90 group-hover:opacity-100 transition-opacity"
					/>
					<span class="flex flex-col font-bold text-white text-lg leading-none">
						<span>Voron</span>
						<span>Creations</span>
					</span>
				</a>
				<p class="max-w-xs text-sm text-white/40 leading-relaxed">
					Roblox incrementals and more from Voron. Live stats and links to every published
					experience.
				</p>
			</div>
			<div>
				<h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-white">Quick links</h3>
				<ul class="space-y-3">
					{
						quick.map((q) => (
							<li>
								<a
									href={q.href}
									class="text-sm text-white/40 transition-colors duration-200 hover:text-white"
								>
									{q.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
			<div>
				<h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-white">
					Connect with us
				</h3>
				<div class="flex items-center gap-4">
					<SocialLinks />
				</div>
			</div>
		</div>
		<div
			class="mt-12 flex flex-col gap-4 border-white/5 border-t pt-8 sm:flex-row sm:items-center sm:justify-between"
		>
			<p class="text-sm text-white/30">
				© {year} Voron Creations. All rights reserved.
			</p>
		</div>
	</div>
</footer>
