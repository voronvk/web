---
import { currentWork, workStatusLabels, type WorkStatus } from '../data/site';

const items = currentWork.items;
if (items.length === 0) return;

const statusStyles: Record<WorkStatus, string> = {
	'in-development': 'border-[#22c55e]/30 bg-[#22c55e]/10 text-[#4ade80]',
	prototype: 'border-white/20 bg-white/5 text-white/70',
	'coming-soon': 'border-white/15 bg-white/[0.03] text-white/55',
};

const gridCols =
	items.length === 1
		? 'md:grid-cols-1 max-w-xl'
		: items.length === 2
			? 'md:grid-cols-2'
			: 'md:grid-cols-2 lg:grid-cols-3';
---

<section
	id="now"
	class="relative z-10 border-white/5 border-t px-4 py-20 sm:px-6 lg:px-8 [content-visibility:auto] [contain-intrinsic-size:auto_520px]"
>
	<div class="mx-auto max-w-7xl">
		<div class="mb-12 md:mb-16 max-w-xl">
			<h2 class="text-sm font-semibold uppercase tracking-widest text-[#22c55e]">
				{currentWork.eyebrow}
			</h2>
			<p class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
				{currentWork.title}
			</p>
			<p class="mt-3 text-base text-white/45">{currentWork.intro}</p>
		</div>
		<div class:list={['grid gap-8', gridCols]}>
			{
				items.map((item) => (
					<article class="overflow-hidden rounded-2xl border border-white/10 bg-white/[0.02] transition-[border-color] duration-500 hover:border-[#22c55e]/35">
						<div class="relative aspect-[16/9] overflow-hidden bg-zinc-900">
							{item.imageSrc ? (
								<img
									src={item.imageSrc}
									alt=""
									width="768"
									height="432"
									class="h-full w-full object-cover"
									loading="lazy"
									decoding="async"
								/>
							) : (
								<div class="flex h-full w-full flex-col items-center justify-center border-b border-dashed border-white/10 px-6 text-center">
									<p class="text-sm font-medium text-white/40">[WIP image]</p>
									<p class="mt-2 text-xs text-white/25">
										Set <code class="text-[#22c55e]/70">imageSrc</code> in site.ts
									</p>
								</div>
							)}
							<span
								class:list={[
									'absolute left-4 top-4 rounded-md border px-2.5 py-1 text-xs font-semibold uppercase tracking-wide',
									statusStyles[item.status],
								]}
							>
								{workStatusLabels[item.status]}
							</span>
						</div>
						<div class="p-5 sm:p-6">
							<h3 class="text-lg font-bold text-white sm:text-xl">{item.title}</h3>
							<p class="mt-2 text-sm leading-relaxed text-white/45 sm:text-base">
								{item.description}
							</p>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
